{
  "title": "shop — architecture",
  "summary": "A small web shop: HTTP handlers call services, services use the storage adapter.",
  "modules": {
    "cmd/shop": {"role": "Process entry point", "desc": "Wires config, storage and the HTTP server.", "layer": "entry"},
    "internal/orders": {"role": "Order domain", "desc": "Creating and paying orders.", "layer": "domain"},
    "internal/storage": {"role": "Postgres adapter", "desc": "Persistence for orders.", "layer": "adapter"}
  },
  "flows": [
    {
      "name": "Place an order",
      "desc": "POST /orders -> validation -> persistence.",
      "steps": [
        "internal/orders/handler.go::Handler.Create",
        "internal/orders/service.go::Service.Place",
        "internal/storage/orders.go::Store.Insert"
      ]
    }
  ]
}
